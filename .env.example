# Pick your LLM provider. "auto" picks OpenAI if OPENAI_API_KEY is set,
# otherwise Anthropic if ANTHROPIC_API_KEY is set.
LLM_PROVIDER=auto

# --- OpenAI (default if your only key is OpenAI) -----------------------
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# --- Anthropic (optional, only if you have it) -------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Local / OCR / storage ---------------------------------------------
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
DATA_DIR=./data
CHROMA_DIR=./data/chroma
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
OCR_CONFIDENCE_THRESHOLD=0.60

# --- Demo mode (no API key needed; fake providers stand in) -----------
DEMO_MODE=false
